# Navigate to backend folder
cd backend

# Create .gitignore in backend
@"
# Environment variables
.env
.env.local
.env.development
.env.test
.env.production

# Node modules
node_modules/

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
"@ | Set-Content .gitignore

# Remove .env from Git if already tracked
git rm --cached .env

# Go back to root
cd ..

# Navigate to blockchain folder
cd blockchain

# Create .gitignore in blockchain
@"
